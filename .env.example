# Provide at least one key for real (non-mock) runs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider/model the judge + verifier use. "anthropic" or "openai".
JUDGE_PROVIDER=anthropic
# e.g. a current Claude model id, or an OpenAI model id if JUDGE_PROVIDER=openai
JUDGE_MODEL=claude-sonnet-5
# Cheap alternative for the whole ablation, e.g.:
#   JUDGE_PROVIDER=openai
#   JUDGE_MODEL=gpt-4o-mini

# Optional: opt-in DNS workaround for a broken local resolver. Leave blank on a normal
# network. Comma-separated host=ip pairs, e.g. DNS_OVERRIDE=api.openai.com=172.66.0.243
DNS_OVERRIDE=

# Server
HOST=0.0.0.0
PORT=8000
